# Database: SQLite by default; Postgres in docker/prod
DATABASE_URL=sqlite:///./data/scholarai.db
# DATABASE_URL=postgresql+psycopg://scholarai:scholarai@localhost:5432/scholarai
JWT_SECRET=change-me-in-production
DEMO_OTP_CODE=123456
CORS_ORIGINS=http://localhost:3000
# Leave empty to run fully offline with the deterministic mock LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=auto   # auto | mock | openai
